# ── LaunchDeckAI mobile env (EXPO_PUBLIC_* are bundled into the client) ──
# Auth (Clerk) — Phase 4
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Backend (Convex) — Phase 4
EXPO_PUBLIC_CONVEX_URL=

# Payments (RevenueCat) — Phase 13
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Analytics (PostHog) — Phase 14
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Error tracking (Sentry) — Phase 14 (DSN is public; client reports via HTTP)
EXPO_PUBLIC_SENTRY_DSN=

# ── Convex environment (set via `npx convex env set`, NOT bundled) ──
# These are server-side secrets — never prefix with EXPO_PUBLIC_ (that bundles
# them into the client). Set each on your deployment with:
#   npx convex env set <NAME> <value>
#
# Claude API (Anthropic) — powers live Astro generation in convex/ai.ts.
# Without it, Convex returns demo drafts (see convex/aiMock.ts).
#   npx convex env set ANTHROPIC_API_KEY sk-ant-...
ANTHROPIC_API_KEY=
#
# CLERK_JWT_ISSUER_DOMAIN=
# REVENUECAT_WEBHOOK_SECRET=
# POSTHOG_PROJECT_API_KEY=
