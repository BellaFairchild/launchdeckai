# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
!.env.example

# IDE / agent tooling (machine-specific; project skills stay under .claude/skills/)
.claude/settings.json
# Ephemeral git worktrees created by agent tooling
.claude/worktrees/

# Playwright MCP test artifacts (ephemeral logs/snapshots)
.playwright-mcp/

# Superpowers brainstorm session state (PID, idle timeout, temp HTML)
.superpowers/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
